# ============================================
# 保险经营智能分析平台 — 环境配置模板
# 使用方式: cp .env.example .env 然后修改
# ============================================

# --- 数据库 (必填) ---
# 本地 Windows 开发:
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/IALMD?charset=utf8mb4
# 服务器 Ubuntu 部署:
# DATABASE_URL=mysql+pymysql://ialmd:你的密码@127.0.0.1:3306/IALMD?charset=utf8mb4

# --- Redis (可选，无则标注 disconnected) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- JWT 密钥 (生产环境务必更换) ---
SECRET_KEY=请替换为至少32位随机字符串
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- 服务配置 ---
API_HOST=0.0.0.0
API_PORT=8002
DEBUG=true

# --- CORS 允许的域名 ---
# 本地开发:
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]
# 服务器部署:
# CORS_ORIGINS=["http://你的服务器IP","https://你的域名"]

# --- 报告文件目录 (默认自动检测，无需修改) ---
# Windows: C:\银行经营\IALMD\data\保险经营报告下载
# Linux:   /opt/ialmd/data/保险经营报告下载
# 自定义路径:
# REPORTS_DIR=/自定义/路径/保险经营报告下载
